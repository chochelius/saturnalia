---
import '../styles/global.css';
import AmbientWebs from '../components/ui/AmbientWebs.astro';
import StickyBottomPlayer from '../components/ui/StickyBottomPlayer';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const {
  title = "Saturnalia999 - Official HomePage",
  description = "Official website of Saturnalia999, gothic solo experimental artist based in Chile. Music, discography, bio and contact.",
  lang = "en",
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#020202" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    {/* Open Graph / Social */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://f4.bcbits.com/img/a4169686274_2.jpg" />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://f4.bcbits.com/img/a4169686274_2.jpg" />

    {/* Preload brand logo for instant 0-lag rendering */}
    <link rel="preload" href="/logo.png" as="image" type="image/png" />

    {/* Preload local Courier Prime font for instant rendering and 0 layout shift */}
    <link
      rel="preload"
      href="/fonts/courier-prime-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* Optimized Google Fonts (Single preconnect and link) */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;600;700&family=Special+Elite&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#020202] text-foreground relative min-h-screen pb-24 md:pb-28">
    <AmbientWebs />
    <div class="relative z-10 min-h-screen flex flex-col justify-between">
      <slot />
    </div>
    <StickyBottomPlayer client:load lang={lang} />
  </body>
</html>
