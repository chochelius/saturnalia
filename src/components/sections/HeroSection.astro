---
import { GlitchText } from "../GlitchText";
import { ParticleBackground } from "../ParticleBackground";

interface Props {
  title: string;
  subtitle: string;
  videoUrl?: string;
  lang?: 'en' | 'es';
}

const {
  title,
  subtitle,
  videoUrl = "https://www.youtube.com/embed/MJo7EKyST6U",
  lang = 'en'
} = Astro.props;

// Normalizar URL de YouTube a embed
function getEmbedUrl(url: string): string {
  if (!url) return "https://www.youtube.com/embed/MJo7EKyST6U";
  if (url.includes("/embed/")) return url;
  const matchWatch = url.match(/[?&]v=([^&#]+)/);
  if (matchWatch && matchWatch[1]) return `https://www.youtube.com/embed/${matchWatch[1]}`;
  const matchShort = url.match(/youtu\.be\/([^?&#]+)/);
  if (matchShort && matchShort[1]) return `https://www.youtube.com/embed/${matchShort[1]}`;
  return url;
}

const formattedVideoUrl = getEmbedUrl(videoUrl);
---

<section
  id="home"
  class="relative min-h-screen flex items-center justify-center text-center overflow-hidden pt-24 pb-12"
>
  <ParticleBackground client:load />
  
  {/* Dark overlay positioned cleanly behind content with clear corners for spiderwebs */}
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-black/30 to-black/60 z-0 pointer-events-none"></div>

  <div class="relative z-10 flex flex-col items-center justify-center p-4 w-full max-w-4xl">
    {/* Sigilo / Logotipo Central */}
    <div class="mb-6 relative group flex items-center justify-center">
      <div class="w-20 h-20 sm:w-24 sm:h-24 p-1.5 rounded-full border-2 border-primary/60 bg-black/80 shadow-[0_0_20px_rgba(28,161,229,0.5)] group-hover:shadow-[0_0_30px_rgba(28,161,229,0.8)] group-hover:border-primary transition-all duration-500 overflow-hidden flex items-center justify-center">
        <img
          src="/logo.png"
          alt="Saturnalia999 Sigil"
          width="96"
          height="96"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="w-full h-full object-contain filter contrast-125 transition-transform duration-500 group-hover:scale-105"
        />
      </div>
      <div class="absolute -inset-1 rounded-full border border-primary/20 pointer-events-none scale-110"></div>
    </div>

    <GlitchText
      text={title}
      as="h1"
      className="text-4xl sm:text-6xl lg:text-7xl font-bold text-glow text-primary"
    />
    <p class="mt-4 mb-8 text-lg md:text-xl text-cover-title text-ghost-glow max-w-2xl font-cover uppercase tracking-widest">
      {subtitle}
    </p>
    <div class="aspect-video w-full max-w-2xl border-2 border-primary/60 shadow-lg shadow-primary/30 bg-black">
      <iframe
        class="w-full h-full border-0"
        src={formattedVideoUrl}
        title="Saturnalia999 - Official Video"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        loading="lazy"
      ></iframe>
    </div>

    <div class="mt-8 flex flex-wrap gap-3 sm:gap-4 justify-center">
      <a
        href={lang === 'en' ? '/discography' : '/es/discography'}
        class="px-5 sm:px-6 py-2.5 border border-primary bg-primary/10 hover:bg-primary text-primary hover:text-black font-headline uppercase tracking-widest text-xs sm:text-sm transition-all duration-300 shadow-lg shadow-primary/20"
      >
        {lang === 'en' ? 'Discography' : 'Discografía'}
      </a>
      <a
        href={lang === 'en' ? '/bio' : '/es/bio'}
        class="px-5 sm:px-6 py-2.5 border border-primary/40 hover:border-primary text-primary hover:text-accent font-headline uppercase tracking-widest text-xs sm:text-sm transition-all duration-300"
      >
        {lang === 'en' ? 'Biography' : 'Biografía'}
      </a>
      <a
        href={lang === 'en' ? '/gallery' : '/es/gallery'}
        class="px-5 sm:px-6 py-2.5 border border-primary/40 hover:border-primary text-primary hover:text-accent font-headline uppercase tracking-widest text-xs sm:text-sm transition-all duration-300"
      >
        {lang === 'en' ? 'Gallery' : 'Galería'}
      </a>
      <a
        href={lang === 'en' ? '/blog' : '/es/blog'}
        class="px-5 sm:px-6 py-2.5 border border-primary/40 hover:border-primary text-primary hover:text-accent font-headline uppercase tracking-widest text-xs sm:text-sm transition-all duration-300"
      >
        {lang === 'en' ? 'Blog' : 'Blog'}
      </a>
      <a
        href={lang === 'en' ? '/contact' : '/es/contact'}
        class="px-5 sm:px-6 py-2.5 border border-primary/40 hover:border-primary text-primary hover:text-accent font-headline uppercase tracking-widest text-xs sm:text-sm transition-all duration-300"
      >
        {lang === 'en' ? 'Contact' : 'Contacto'}
      </a>
      <a
        href={lang === 'en' ? '/links' : '/es/links'}
        class="px-5 sm:px-6 py-2.5 border border-primary/40 hover:border-primary text-primary hover:text-accent font-headline uppercase tracking-widest text-xs sm:text-sm transition-all duration-300"
      >
        {lang === 'en' ? 'Links' : 'Enlaces'}
      </a>
    </div>
  </div>
</section>
