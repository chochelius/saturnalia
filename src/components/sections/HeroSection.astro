---
import { GlitchText } from "../GlitchText";
import { ParticleBackground } from "../ParticleBackground";

interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<section
  id="home"
  class="relative min-h-screen flex items-center justify-center text-center overflow-hidden pt-24 pb-12"
>
  <ParticleBackground client:load />
  
  {/* Dark overlay positioned cleanly behind content */}
  <div class="absolute inset-0 bg-black/60 z-0 pointer-events-none"></div>

  <div class="relative z-10 flex flex-col items-center justify-center p-4 w-full max-w-4xl">
    <GlitchText
      text={title}
      as="h1"
      className="text-4xl sm:text-6xl lg:text-7xl font-bold text-glow text-primary"
    />
    <p class="mt-4 mb-8 text-lg md:text-xl text-cover-title text-ghost-glow max-w-2xl font-cover uppercase tracking-widest">
      {subtitle}
    </p>
    <div class="aspect-video w-full max-w-2xl border-2 border-primary/60 shadow-lg shadow-primary/30">
      <iframe
        class="w-full h-full border-0"
        src="https://www.youtube.com/embed/MJo7EKyST6U"
        title="Saturnalia999 - Video Transmission"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        loading="lazy"
      ></iframe>
    </div>
  </div>
</section>
