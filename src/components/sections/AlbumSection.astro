---
import type { Album, TrackItem } from '../../lib/pocketbase';
import { GlitchText } from "../GlitchText";
import AudioPlayer from "../ui/AudioPlayer";

interface Props {
  title: string;
  buyNowText: string;
  albums: Album[];
  tracks?: TrackItem[];
  lang?: 'en' | 'es';
}

const { title, buyNowText, albums, tracks = [], lang = 'en' } = Astro.props;
---

<section id="albums" class="py-20 sm:py-32">
  <div class="container mx-auto px-4">
    <GlitchText
      text={title}
      as="h2"
      className="text-4xl md:text-5xl font-bold text-center mb-12 text-glow text-primary"
    />
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {albums.map((album) => (
        <div class="bg-[#020202]/90 border border-primary/30 backdrop-blur-sm overflow-hidden group transform hover:-translate-y-1 hover:border-primary transition-all duration-300 rounded-none shadow-lg shadow-primary/10 flex flex-col justify-between">
          <div>
            <div class="aspect-square overflow-hidden border-b border-primary/30 bg-black relative">
              <img
                src={album.cover}
                alt={album.title}
                width={500}
                height={500}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 chromatic-hover transition-all duration-500"
              />
            </div>
            <div class="p-6 pb-2">
              <h3 class="font-cover text-2xl text-cover-title text-ghost-glow tracking-wide">
                {album.title}
              </h3>
              <span class="font-cover text-xs text-cover-artist opacity-70 block mt-1.5">
                Saturnalia999
              </span>
            </div>

            {/* Reproductor de audio y tracklist conectado con Cloudflare R2 */}
            <div class="px-6 pb-4">
              <AudioPlayer
                client:visible
                title={album.title}
                album={album}
                tracks={tracks.filter((t) => t.albumId === album.id)}
                audioUrl={album.audioUrl}
                streamUrl={album.streamUrl}
                bandcampEmbedId={album.bandcampEmbedId}
                lang={lang}
              />
            </div>
          </div>

          <div class="flex justify-between items-center border-t border-primary/20 p-6 pt-4 bg-[#020202]">
            <p class="text-xl font-cover text-ghost-glow font-bold">
              ${album.price.toFixed(2)}
            </p>
            <a
              href={album.streamUrl || "https://saturnalia999.bandcamp.com/releases"}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center font-headline uppercase border border-primary text-primary hover:bg-primary hover:text-black transition-colors duration-300 icon-glow rounded-none px-4 py-2 text-sm font-semibold tracking-wider"
            >
              {buyNowText}
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
