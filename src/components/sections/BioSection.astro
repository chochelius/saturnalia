---
import { GlitchText } from "../GlitchText";
import { Separator } from "../ui/separator";

interface Props {
  title: string;
  paragraphs: string[];
}

const { title, paragraphs } = Astro.props;
---

<section id="bio" class="py-20 sm:py-32 bg-[#060606]/95 backdrop-blur-md border-y border-primary/30 shadow-xl shadow-black/80">
  <div class="container mx-auto px-4 text-center">
    <GlitchText
      text={title}
      as="h2"
      className="text-4xl md:text-5xl font-bold mb-8 text-glow text-primary"
    />
    <Separator className="w-24 mx-auto bg-primary mb-8" />
    <div class="max-w-3xl mx-auto space-y-6">
      {paragraphs.map((paragraph) => (
        <p
          class="text-lg sm:text-xl text-foreground/90 leading-relaxed tracking-wider font-body selection:bg-primary selection:text-black"
          set:html={paragraph}
        />
      ))}
    </div>
  </div>
</section>
