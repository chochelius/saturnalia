---
// AmbientWebs.astro: High-performance vector spiderweb corners with static GPU glow
---

<div class="fixed inset-0 pointer-events-none z-0 overflow-hidden select-none" aria-hidden="true">
  {/* Static corner ambient illumination (0 animation cost, GPU rasterized once) */}
  <div class="absolute -top-20 -left-20 w-[450px] h-[450px] rounded-full bg-primary/12 blur-[80px] pointer-events-none"></div>
  <div class="absolute -top-20 -right-20 w-[450px] h-[450px] rounded-full bg-primary/10 blur-[80px] pointer-events-none"></div>

  {/* Top Left Spiderweb Anchor */}
  <svg
    class="absolute top-0 left-0 w-[420px] h-[420px] sm:w-[560px] sm:h-[560px] lg:w-[680px] lg:h-[680px] animate-web-tl"
    viewBox="0 0 700 700"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <radialGradient id="fade-tl" cx="0%" cy="0%" r="95%">
        <stop offset="0%" stop-color="#ffffff" stop-opacity="1" />
        <stop offset="65%" stop-color="#ffffff" stop-opacity="0.9" />
        <stop offset="85%" stop-color="#ffffff" stop-opacity="0.4" />
        <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
      </radialGradient>
      
      <linearGradient id="web-gradient-tl" x1="0" y1="0" x2="620" y2="620" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#ffffff" stop-opacity="0.85" />
        <stop offset="30%" stop-color="#67cdf7" stop-opacity="0.75" />
        <stop offset="65%" stop-color="#1ca1e5" stop-opacity="0.55" />
        <stop offset="88%" stop-color="#0f415b" stop-opacity="0.25" />
        <stop offset="100%" stop-color="#020202" stop-opacity="0" />
      </linearGradient>

      <mask id="mask-tl">
        <rect width="700" height="700" fill="url(#fade-tl)" />
      </mask>
    </defs>

    <g mask="url(#mask-tl)" stroke="url(#web-gradient-tl)">
      {/* Radial Web Spine Rays */}
      <line x1="0" y1="0" x2="680" y2="40" stroke-width="1.2" />
      <line x1="0" y1="0" x2="650" y2="130" stroke-width="1.2" />
      <line x1="0" y1="0" x2="600" y2="230" stroke-width="1.2" />
      <line x1="0" y1="0" x2="520" y2="340" stroke-width="1.2" />
      <line x1="0" y1="0" x2="420" y2="440" stroke-width="1.4" />
      <line x1="0" y1="0" x2="310" y2="530" stroke-width="1.2" />
      <line x1="0" y1="0" x2="200" y2="610" stroke-width="1.2" />
      <line x1="0" y1="0" x2="100" y2="660" stroke-width="1.2" />
      <line x1="0" y1="0" x2="25" y2="690" stroke-width="1.2" />

      {/* Ring 1 - Inner Core */}
      <path d="M 50 3 Q 48 10 47 11 Q 44 17 42 19 Q 37 25 35 28 Q 28 35 25 37 Q 19 42 17 44 Q 11 47 10 48 Q 3 50 0 50" stroke-width="1.0" fill="none" />

      {/* Ring 2 */}
      <path d="M 100 6 Q 96 20 94 22 Q 88 34 84 38 Q 74 50 70 56 Q 56 70 50 74 Q 38 84 34 88 Q 22 94 20 96 Q 6 100 0 100" stroke-width="1.0" fill="none" />

      {/* Ring 3 */}
      <path d="M 160 10 Q 153 32 150 35 Q 140 55 134 61 Q 118 80 112 90 Q 90 112 80 118 Q 61 134 55 140 Q 35 150 32 153 Q 10 160 0 160" stroke-width="1.0" fill="none" />

      {/* Ring 4 */}
      <path d="M 230 14 Q 220 46 215 50 Q 201 79 193 88 Q 170 115 161 129 Q 129 161 115 170 Q 88 193 79 201 Q 50 215 46 220 Q 14 230 0 230" stroke-width="1.1" fill="none" />

      {/* Ring 5 */}
      <path d="M 310 18 Q 296 62 290 68 Q 271 107 260 118 Q 229 155 217 174 Q 174 217 155 229 Q 118 260 107 271 Q 68 290 62 296 Q 18 310 0 310" stroke-width="1.1" fill="none" />

      {/* Ring 6 */}
      <path d="M 400 24 Q 382 80 374 88 Q 350 138 335 152 Q 295 200 280 225 Q 225 280 200 295 Q 152 335 138 350 Q 88 374 80 382 Q 24 400 0 400" stroke-width="1.15" fill="none" />

      {/* Ring 7 */}
      <path d="M 500 30 Q 478 100 468 110 Q 437 172 419 190 Q 369 250 350 281 Q 281 350 250 369 Q 190 419 172 437 Q 110 468 100 478 Q 30 500 0 500" stroke-width="1.2" fill="none" />

      {/* Ring 8 */}
      <path d="M 610 36 Q 583 122 571 134 Q 533 210 511 232 Q 450 305 427 343 Q 343 427 305 450 Q 232 511 210 533 Q 134 571 122 583 Q 36 610 0 610" stroke-width="1.2" fill="none" />
      
      {/* Gossamer droplet points on intersections */}
      <circle cx="217" cy="174" r="2.2" fill="#67cdf7" opacity="0.85" />
      <circle cx="174" cy="217" r="2.2" fill="#67cdf7" opacity="0.85" />
      <circle cx="280" cy="225" r="2.5" fill="#ffffff" opacity="0.9" />
      <circle cx="225" cy="280" r="2.5" fill="#ffffff" opacity="0.9" />
      <circle cx="350" cy="281" r="3" fill="#67cdf7" opacity="0.85" />
      <circle cx="281" cy="350" r="3" fill="#67cdf7" opacity="0.85" />
    </g>
  </svg>

  {/* Top Right Spiderweb Anchor (Mirrored & Subtle) */}
  <svg
    class="absolute top-0 right-0 w-[360px] h-[360px] sm:w-[480px] sm:h-[480px] lg:w-[580px] lg:h-[580px] animate-web-tr"
    viewBox="0 0 700 700"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <radialGradient id="fade-tr" cx="0%" cy="0%" r="95%">
        <stop offset="0%" stop-color="#ffffff" stop-opacity="1" />
        <stop offset="65%" stop-color="#ffffff" stop-opacity="0.9" />
        <stop offset="85%" stop-color="#ffffff" stop-opacity="0.4" />
        <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
      </radialGradient>
      
      <linearGradient id="web-gradient-tr" x1="0" y1="0" x2="620" y2="620" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#ffffff" stop-opacity="0.8" />
        <stop offset="35%" stop-color="#67cdf7" stop-opacity="0.65" />
        <stop offset="70%" stop-color="#1ca1e5" stop-opacity="0.45" />
        <stop offset="90%" stop-color="#0f415b" stop-opacity="0.2" />
        <stop offset="100%" stop-color="#020202" stop-opacity="0" />
      </linearGradient>

      <mask id="mask-tr">
        <rect width="700" height="700" fill="url(#fade-tr)" />
      </mask>
    </defs>

    <g mask="url(#mask-tr)" stroke="url(#web-gradient-tr)">
      <line x1="0" y1="0" x2="680" y2="40" stroke-width="1.2" />
      <line x1="0" y1="0" x2="650" y2="130" stroke-width="1.2" />
      <line x1="0" y1="0" x2="600" y2="230" stroke-width="1.2" />
      <line x1="0" y1="0" x2="520" y2="340" stroke-width="1.2" />
      <line x1="0" y1="0" x2="420" y2="440" stroke-width="1.4" />
      <line x1="0" y1="0" x2="310" y2="530" stroke-width="1.2" />
      <line x1="0" y1="0" x2="200" y2="610" stroke-width="1.2" />
      <line x1="0" y1="0" x2="100" y2="660" stroke-width="1.2" />
      <line x1="0" y1="0" x2="25" y2="690" stroke-width="1.2" />

      <path d="M 50 3 Q 48 10 47 11 Q 44 17 42 19 Q 37 25 35 28 Q 28 35 25 37 Q 19 42 17 44 Q 11 47 10 48 Q 3 50 0 50" stroke-width="1.0" fill="none" />
      <path d="M 100 6 Q 96 20 94 22 Q 88 34 84 38 Q 74 50 70 56 Q 56 70 50 74 Q 38 84 34 88 Q 22 94 20 96 Q 6 100 0 100" stroke-width="1.0" fill="none" />
      <path d="M 160 10 Q 153 32 150 35 Q 140 55 134 61 Q 118 80 112 90 Q 90 112 80 118 Q 61 134 55 140 Q 35 150 32 153 Q 10 160 0 160" stroke-width="1.0" fill="none" />
      <path d="M 230 14 Q 220 46 215 50 Q 201 79 193 88 Q 170 115 161 129 Q 129 161 115 170 Q 88 193 79 201 Q 50 215 46 220 Q 14 230 0 230" stroke-width="1.1" fill="none" />
      <path d="M 310 18 Q 296 62 290 68 Q 271 107 260 118 Q 229 155 217 174 Q 174 217 155 229 Q 118 260 107 271 Q 68 290 62 296 Q 18 310 0 310" stroke-width="1.1" fill="none" />
      <path d="M 400 24 Q 382 80 374 88 Q 350 138 335 152 Q 295 200 280 225 Q 225 280 200 295 Q 152 335 138 350 Q 88 374 80 382 Q 24 400 0 400" stroke-width="1.15" fill="none" />
      <path d="M 500 30 Q 478 100 468 110 Q 437 172 419 190 Q 369 250 350 281 Q 281 350 250 369 Q 190 419 172 437 Q 110 468 100 478 Q 30 500 0 500" stroke-width="1.2" fill="none" />
      <path d="M 610 36 Q 583 122 571 134 Q 533 210 511 232 Q 450 305 427 343 Q 343 427 305 450 Q 232 511 210 533 Q 134 571 122 583 Q 36 610 0 610" stroke-width="1.2" fill="none" />

      <circle cx="280" cy="225" r="2.2" fill="#67cdf7" opacity="0.8" />
      <circle cx="225" cy="280" r="2.2" fill="#67cdf7" opacity="0.8" />
    </g>
  </svg>
</div>

<style>
  @keyframes webDriftTL {
    0%, 100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(6px, 5px, 0);
    }
  }

  @keyframes webDriftTR {
    0%, 100% {
      transform: scaleX(-1) translate3d(0, 0, 0);
    }
    50% {
      transform: scaleX(-1) translate3d(-5px, 6px, 0);
    }
  }

  .animate-web-tl {
    animation: webDriftTL 18s ease-in-out infinite alternate;
    will-change: transform;
    transform-origin: top left;
  }

  .animate-web-tr {
    animation: webDriftTR 22s ease-in-out infinite alternate;
    will-change: transform;
    transform-origin: top right;
  }
</style>
